# =============================================================================
#  SciPulse — Variables d'environnement
#  Copier ce fichier en .env et adapter les valeurs si nécessaire
#  Usage : cp .env.example .env
#  (les valeurs ci-dessous sont celles utilisées depuis la machine hôte ;
#   dans les conteneurs Airflow, docker-compose.yml les remplace par les
#   noms de services Docker : elasticsearch, postgres, minio)
# =============================================================================

# --- Elasticsearch / Kibana ---
ES_HOST=http://localhost:9200
KIBANA_HOST=http://localhost:5601

# --- PostgreSQL (dbt) ---
PG_HOST=localhost
PG_PORT=5432
PG_USER=scipulse
PG_PASSWORD=scipulse
PG_DATABASE=scipulse

# --- MinIO (S3) ---
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin

# --- Airflow ---
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=admin
# Linux uniquement : votre UID, pour que les fichiers écrits par Airflow vous appartiennent
# AIRFLOW_UID=1000

# --- HN Poller ---
HN_POLL_INTERVAL=60
HN_BATCH_SIZE=50
