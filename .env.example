# =============================================================================
#  SciPulse — variables d'environnement (cp .env.example .env)
#  Valeurs pour les scripts lancés depuis l'hôte ; dans les conteneurs Airflow,
#  docker-compose.yml utilise les noms de services (minio, elasticsearch, postgres).
# =============================================================================

# --- MinIO (data lake Medallion) ---
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin

# --- Elasticsearch / Kibana (couche Gold) ---
ES_HOST=http://localhost:9200
KIBANA_HOST=http://localhost:5601

# --- PostgreSQL (dbt) ---
PG_HOST=localhost
PG_PORT=5432
PG_USER=scipulse
PG_PASSWORD=scipulse
PG_DATABASE=scipulse

# --- Sources ---
# Fichier ArXiv local (dump complet ou sous-ensemble) ; absent → téléchargement Kaggle
ARXIV_SOURCE_FILE=data/arxiv-cs-subset-100k.json
KAGGLE_USERNAME=
KAGGLE_KEY=
# OpenAlex : clé API gratuite (compte sur openalex.org) — budget quotidien × 10,
# recommandée pour le corpus complet ; e-mail de contact facultatif
OPENALEX_API_KEY=
OPENALEX_MAILTO=

# --- Spark (exécution locale hors cluster) ---
SPARK_MASTER=local[*]
LAKE_URI=s3a://

# --- Airflow ---
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=admin
# Linux uniquement : votre UID (fichiers écrits par Airflow à votre nom)
# AIRFLOW_UID=1000
